diff -ru a/t/01-workspaces.t b/t/01-workspaces.t
--- a/t/01-workspaces.t
+++ b/t/01-workspaces.t
@@ -1,13 +1,16 @@
 #!perl -T
 # vim:ts=4:sw=4:expandtab
 
-use Test::More tests => 3;
+use Test::More;
 use AnyEvent::I3;
 use AnyEvent;
 
-my $i3 = i3();
+my $i3 = eval { i3() };
 my $cv = AnyEvent->condvar;
 
+plan skip_all => 'No i3 binary or socket path available' if $@ || !$i3;
+plan tests => 3;
+
 # Try to connect to i3
 $i3->connect->cb(sub { my ($v) = @_; $cv->send($v->recv) });
 
