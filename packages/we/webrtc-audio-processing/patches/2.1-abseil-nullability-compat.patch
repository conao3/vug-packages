--- a/webrtc/api/abseil_nullability_compat.h
+++ b/webrtc/api/abseil_nullability_compat.h
@@ -0,0 +1,34 @@
+// Compatibility shim for abseil releases that removed the
+// absl::Nonnull / absl::Nullable / absl::NullabilityUnknown template
+// aliases in favor of the absl_nonnull / absl_nullable macros
+// (templates present through abseil 20250127, gone by 20260817).
+// Upstream documents these annotations as a human readable signal
+// with no semantics, so identity aliases are sufficient.
+
+#ifndef API_ABSEIL_NULLABILITY_COMPAT_H_
+#define API_ABSEIL_NULLABILITY_COMPAT_H_
+
+#include "absl/base/nullability.h"
+
+#if defined(__has_include)
+#  if __has_include("absl/base/internal/nullability_impl.h")
+#    define WEBRTC_ABSEIL_HAS_NULLABILITY_TEMPLATES 1
+#  endif
+#endif
+
+#if !defined(WEBRTC_ABSEIL_HAS_NULLABILITY_TEMPLATES)
+namespace absl {
+
+template <typename T>
+using Nullable = T;
+
+template <typename T>
+using Nonnull = T;
+
+template <typename T>
+using NullabilityUnknown = T;
+
+}  // namespace absl
+#endif  // !defined(WEBRTC_ABSEIL_HAS_NULLABILITY_TEMPLATES)
+
+#endif  // API_ABSEIL_NULLABILITY_COMPAT_H_
